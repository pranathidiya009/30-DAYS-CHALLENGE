{3000,3500,5000,5200,3000,2900,3100},
{500,520,510,530,500,490,505},
{2000,2900,2000,2000,2000,2000,2000},
{800,800,800,800,800,800,800}};
int t[ZONES]={5000,3200,600,2200,900},z,d;
