int main(void){
int usage[ZONES][DAYS],dailytarget[ZONES];
int excess[ZONES],over[ZONES],spike[ZONES],alert[ZONES];
int choice,auditdone=0;

printf("waterwise- track.detect.conserve\n");
if(readvalid("1= enter data,2 = simulated test data:",1,2)==1)
inputwaterdata(usage,dailytarget);
else
loadsimulatedata(usage,dailytarget);

do{
printf("\n====== MENU ======\n 1.display water data \n 2.generate audit report\n""3.raank zones by excess\n4.conservation actions\n5. exit\n");
choice=readvalid("choice:",1,5);
if(choice==1)
displaywaterdata(usage,dailytarget);
else if(choice==2){
generateauditreport(usage,dailytarget,excess,over,spike,alert);
auditdone=1;}
else if((choice==3 || choice==4)&& !auditdone)
printf("run option2(audit report) first.\n");
else if(choice==3)
rankzones(excess);
else if(choice==4)
displayconservationactions(over,spike,excess);}
while(choice!=5);
return 0;
}
