#include <stdio.h>
#define ZONES 5
#define DAYS 7
const char *zoneName(int z)
{
switch (z){
case 0: return "Academic block";
case 1:return "hostel";
case 2:return "library";
case 3: return "cafeteria";
default:return "sports complex";}

int readvalid(const char *msg, int lo,int hi)
{
int x;
while(1){
printf("%s",msg);
if(scanf("%d",&x) != 1)
{ scanf("%*s");
printf("enter a number\n");}
else if(x<lo || x>hi)
printf("must be %d to %d\n",lo,hi);
else return x;}
}

void inputwaterdata(int usage[ZONES][DAYS],int dailytarget[ZONES])
{
int z,d;
for(z=0;z<ZONES;z++)
{
printf("\n-----%s----\n",zoneName(z));
dailytarget[z]=readvalid("daily taget (100-50000 L):",100,50000);
for(d=0;d<DAYS;d++){
printf("DAY %d",d+1);
usage[z][d]=readvalid("reading (0-50000L):",0,50000);}
}
}

void displaywaterdata(int usage[ZONES][DAYS],int dailytarget[ZONES])
{
int z,d;
for(z=0;z<ZONES;z++){
printf("\n zone: %s\n",zoneName(z));
printf("dailytarget: %d L\n",dailytarget[z]);
for(d=0;d<DAYS;d++){
printf("day%d:%d L\n",d+1,usage[z][d]);
}}}

//total,avg,peak,peak day
void calculatezonestats(int *zoneusage,int *total,float *average,int *peakusage,int *peakday){
int sum=0,d;
*peakusage=*zoneusage;
*peakday=1;
for(d=0;d<DAYS;d++)
{
sum+= *(zoneusage + d);
if(*(zoneusage + d)> *peakusage){
*peakusage= *(zoneusage +  d);
*peakday=d+1;}
}
*total=sum;
*average=(float)sum/DAYS;
}

void detectwateralerts(int *zoneusage,int dailytarget,int *overlimitdays,int *totalexcess,int *spikedays,int *alertdays){
int d,over,spike;
*overlimitdays=*totalexcess= *spikedays = *alertdays=0;
for(d=0;d<DAYS;d++)
{
over= *(zoneusage + d)> dailytarget;
spike=(d>0 && *(zoneusage +d)*100 > *(zoneusage +d-1)*140);
if(over){
(*overlimitdays)++;
*totalexcess+= *(zoneusage + d) - dailytarget;}
if(spike)
(*spikedays)++;
if(over || spike)
(*alertdays)++;
}
}


void generateauditreport(int usage[ZONES][DAYS],int dailytarget[ZONES],int excessbyzone[ZONES],int overlimitbyzone[ZONES],int spikebyzones[ZONES],int alertbyzone[ZONES]){
int z,total,peak,peakday;
float avg;
printf("\n-------------AUDIT REPORT-----------\n");
for(z=0;z<ZONES;z++){
calculatezonestats(&usage[z][0],&total,&avg,&peak,&peakday);
detectwateralerts(&usage[z][0],dailytarget[z],&overlimitbyzone[z],&excessbyzone[z],&spikebyzones[z],&alertbyzone[z]);
printf("\n%s(target %d L/day)\n",zoneName(z),dailytarget[z]);
printf("total : %d L | average:%.2f L \n",total,avg);
printf("peak:%d L on day %d\n",peak,peakday);
printf("over limit days:%d| excess : %d L\n",overlimitbyzone[z],excessbyzone[z]);
printf("spike days:%d| unique alert days:%d\n",spikebyzones[z],alertbyzone[z]);}
}

int rankof(int excessbyzone[ZONES],int z){
int rank=1,j;
for(j=0;j<ZONES;j++){
if(excessbyzone[j]>excessbyzone[z])
rank++;}
return rank;
}

void rankzones(int excessbyzone[ZONES]){
int z,r,top=0;
printf("\n============== ZONE RAKING=============\nhighest excess zone(s):");
for(z=0;z<ZONES;z++){
if(rankof(excessbyzone,z)==1){
printf("%s",zoneName(z));
top=excessbyzone[z];}
printf("(%d L )\n\n%-6s%-15s%s\n",top,"rank","zone","excess(L)");
for(r=1;r<=ZONES;r++){
for(z=0;z<ZONES;z++)
if(rankof(excessbyzone,z)==r)
printf("%-6d%-15s%d\n",r,zoneName(z),excessbyzone[z]);}}
}

void displayconservationactions(int overlimitbyzone[ZONES],int spikebyzone[ZONES],int excessbyzone[ZONES]){
int z;
printf("\n======= CONSERVATION ACTIONS===========\n");
for(z=0;z<ZONES;z++){
printf("\n%s (excess %d L ):\n",zoneName(z),excessbyzone[z]);
if(spikebyzone[z]>0)
printf(" check for a leak or unexpected use around the flagged days\n");
if(overlimitbyzone[z]>=3)
printf("priority : water audit and reduction plan\n");
else if(overlimitbyzone[z]>=1)
printf("monitor those days and inspect tape/valves\n");
if(spikebyzone[z]==0 && overlimitbyzone[z]==0)
printf("maintain current good practices\n");}
}

